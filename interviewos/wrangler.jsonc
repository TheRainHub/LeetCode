{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Worker that serves InterviewOS (built by @opennextjs/cloudflare). See README → "Deploying to Cloudflare".
  "name": "interviewos",
  // worker.mjs wraps the generated .open-next/worker.js and adds the scheduled handler.
  "main": "worker.mjs",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "interviewos",
    },
  ],
  // Automatic job search: every hour the Worker runs at most one saved search that is due
  // (each search has its own interval in the app). Needs the CRON_SECRET secret.
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
  // Optional: connection pooling for PostgreSQL. Create it with
  //   npx wrangler hyperdrive create interviewos-db --connection-string="postgres://…"
  // then uncomment and paste the id. Without it the Worker connects with DATABASE_URL directly.
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "<hyperdrive id>",
  //   },
  // ],
}
