{
  "name": "interviewos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "bank:import": "tsx scripts/import-problem-bank.ts",
    "bank:verify-visualizations": "tsx scripts/verify-visualizations.ts",
    "content:check-links": "tsx scripts/check-links.ts",
    "content:verify-harnesses": "tsx scripts/verify-harnesses.ts",
    "postinstall": "node scripts/copy-monaco.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@monaco-editor/react": "4.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "geist": "1.8.2",
    "gray-matter": "4.0.3",
    "lucide-react": "1.59.0",
    "monaco-editor": "0.57.0",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.6",
    "recharts": "3.10.1",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "sucrase": "3.35.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.2",
    "dotenv": "17.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "jsdom": "27.4.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
