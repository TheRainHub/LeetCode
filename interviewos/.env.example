# ---- Database (required) ----
# PostgreSQL connection string. See README for creating the role and database.
DATABASE_URL=postgres://interviewos:interviewos@localhost:5432/interviewos

# ---- AI features (optional) ----
# Without a key the app works fully; the mock interviewer and AI grading are disabled.
# The key is only read on the server and never sent to the browser.
ANTHROPIC_API_KEY=
# Model used for interviews and evaluations.
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max
ANTHROPIC_EFFORT_CHAT=medium
ANTHROPIC_EFFORT_EVALUATION=high
# Output token ceilings (thinking counts toward these).
ANTHROPIC_MAX_TOKENS_CHAT=8000
ANTHROPIC_MAX_TOKENS_EVALUATION=16000
# Server-side refusal fallback ("default" lets the API pick a fallback model; "off" disables it).
ANTHROPIC_FALLBACKS=default

# ---- App ----
# IANA time zone used for "today", streaks and scheduling.
APP_TIMEZONE=Europe/Prague
